# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.installed.cfg
build/
dist/
wheels/

# Virtual environments (huge — never needed in image)
venv/
.venv/
env/
genv/
enterprise_env/
tenvv/

# Environment & secrets
.env
frontend/.env.local
commands.md

# Git & IDE
.git/
.gitignore
.vscode/
.idea/

# Observability local state
.logfire/

# Claude Code memory
.claude/

# Data is not needed in the backend runtime image.
DATA/

# Frontend build artifacts and installed packages are not part of the backend image.
frontend/node_modules/
frontend/.next/

# Evaluation tooling is run separately from the backend service.
evals/

# Notebooks and documentation are not needed at runtime.
notebooks/
DOCS/

# OS
.DS_Store
Thumbs.db
*.log
