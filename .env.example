# Gemini chat model routed through Portkey for planner, responder, and guardrails
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Portkey saved configuration. The config ID retains the configured primary and
# fallback route; the primary slug selects the Gemini model for the request.
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=
PORTKEY_FALLBACK_SLUG=
PORTKEY_PRIMARY_CONFIG_ID=

# RAGAS evaluation judge (Gemini only; runtime Gemini key is used when judge key is empty)
JUDGE_PROVIDER=gemini
JUDGE_GEMINI_API_KEY=
JUDGE_GEMINI_MODEL=gemini-2.5-flash

# Jina embeddings and reranking. If omitted, local mxbai embeddings are used
# and reranking is skipped. Do not change the embedding model after indexing.
JINA_API_KEY=

# Qdrant vector database. Defaults to local Qdrant on port 6333.
# QDRANT_URL is also accepted; configure only one endpoint variable.
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag
# Docker Compose override; use the qdrant service name from inside containers.
DOCKER_QDRANT_URL=http://qdrant:6333
DOCKER_QDRANT_API_KEY=

# Optional durable conversation state (otherwise in-memory, lost on restart).
NEON_DB_URL=

# Optional distributed rate limiting (otherwise process-local in-memory limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API safety
RAG_API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Optional observability
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag_scale_test

# Backend URL for evaluation clients (defaults to localhost:8000)
BACKEND_URL=http://localhost:8000
